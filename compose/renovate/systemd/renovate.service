[Unit]
Description=Renovate Self-Hosted Dependency Update Runner
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/matthewkdies/Documents/compose/renovate
ExecStart=/bin/bash -c '. /home/matthewkdies/.envvars && exec /usr/bin/docker compose --file renovate-compose.yaml run --rm renovate'
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
